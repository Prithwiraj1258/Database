USE DUMMYDB;
SELECT DISTINCT SALARY # DISTINCT DILE EKI VALUE  MULTIPLE TIMES ASHBE NA
FROM EMPLOYEES
ORDER BY SALARY DESC
LIMIT 1
OFFSET 1; #2ND HIGHEST
