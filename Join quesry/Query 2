use dummydb;

SELECT  EMPLOYEES.FIRST_NAME, DEPARTMENTS.DEPARTMENT_NAME
FROM EMPLOYEES 
CROSS JOIN DEPARTMENTS ON EMPLOYEES.DEPARTMENT_ID= DEPARTMENTS.DEPARTMENT_ID;
#QUESTION 1
SELECT  M.FIRST_NAME,E.FIRST_NAME
FROM EMPLOYEES AS m
JOIN EMPLOYEES AS e
ON E.EMPLOYEE_ID= M.MANAGER_ID;
#QUESTION 2
SELECT DEPARTMENTS.DEPARTMENT_NAME,EMPLOYEES.DEPARTMENT_ID
FROM DEPARTMENTS
LEFT JOIN EMPLOYEES
    ON DEPARTMENTS.DEPARTMENT_ID=EMPLOYEES.DEPARTMENT_ID
    WHERE EMPLOYEES.DEPARTMENT_ID IS NULL;
#qUESTION 3
SELECT EMPLOYEES.FIRST_NAME, 
EMPLOYEES.SALARY, 
((SELECT AVG(SALARY) FROM EMPLOYEES WHERE DEPARTMENT_ID = EMPLOYEES.DEPARTMENT_ID) - EMPLOYEES.SALARY) AS LESS_SALARY
FROM EMPLOYEES
	JOIN DEPARTMENTS
		ON EMPLOYEES.DEPARTMENT_ID = DEPARTMENTS.DEPARTMENT_ID;
        #question 4
SELECT DEPARTMENT_NAME, MIN(SALARY), AVG(SALARY)
FROM EMPLOYEES
	JOIN DEPARTMENTS
		ON  EMPLOYEES.DEPARTMENT_ID = DEPARTMENTS.DEPARTMENT_ID
GROUP BY DEPARTMENT_NAME
HAVING MIN(SALARY) > 2000;
